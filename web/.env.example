# Build-time only (Vite requires the VITE_ prefix to expose a var to
# client code — see src/config/apiBaseUrl.ts). The API's absolute base
# URL, once it's deployed somewhere real. Leave unset for local dev: Vite's
# dev-server proxy (vite.config.ts) already forwards the default relative
# "/api" path to a local Laravel instance, and every build without this
# set behaves exactly the same way — same-origin relative, nothing new.
VITE_API_BASE_URL=https://api.clintra.example.com/api
