{
    "name": "clintra/admin",
    "type": "project",
    "license": "proprietary",
    "require": {
        "php": "^8.3",
        "laravel/framework": "13.43.0",
        "filament/filament": "4.16.4"
    },
    "require-dev": {
        "pestphp/pest": "4.7.8",
        "pestphp/pest-plugin-laravel": "4.1.0",
        "mockery/mockery": "1.6.15",
        "nunomaduro/collision": "8.9.6"
    },
    "autoload": {
        "psr-4": {
            "App\\": "app/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Tests\\": "tests/"
        }
    },
    "scripts": {
        "post-autoload-dump": [
            "Illuminate\\Foundation\\ComposerScripts::postAutoloadDump",
            "@php artisan package:discover --ansi"
        ],
        "test": [
            "@php artisan test"
        ]
    },
    "config": {
        "sort-packages": true,
        "allow-plugins": {
            "pestphp/pest-plugin": true
        }
    },
    "minimum-stability": "stable",
    "prefer-stable": true,
    "description": "Separate platform administration panel for Clintra."
}
