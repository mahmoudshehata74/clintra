# dependencies
node_modules/
vendor/

# build output
dist/
build/
.vite/

# environment
.env
.env.*
!.env.example

# logs
*.log
npm-debug.log*
pnpm-debug.log*

# editor and OS
.vscode/*
!.vscode/extensions.json
.idea/
.DS_Store
Thumbs.db

# tests
coverage/
playwright-report/
test-results/
# Visual-review screenshots regenerate on demand (pnpm test:e2e:screenshots); never committed.
web/e2e/screenshots/

# local working files
/local/

# local assistant tooling (never committed)
CLAUDE.md
.claude/
.mcp.json

# api/ (Laravel) — contents ignored, directory structure stays tracked
api/vendor/
api/.env
api/database/database.sqlite
api/storage/logs/*
!api/storage/logs/.gitignore
api/storage/framework/cache/*
!api/storage/framework/cache/.gitignore
api/storage/framework/sessions/*
!api/storage/framework/sessions/.gitignore
api/storage/framework/views/*
!api/storage/framework/views/.gitignore
api/bootstrap/cache/*
!api/bootstrap/cache/.gitignore
