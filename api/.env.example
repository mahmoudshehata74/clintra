APP_NAME=Laravel
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000

APP_LOCALE=ar
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

# Two Postgres roles, on purpose: clintra_owner owns every table and is the
# only role migrations run as; clintra_app is what Laravel connects as at
# runtime and owns nothing. A table owner bypasses Row-Level Security
# silently, so the app must never be the owner — see api/docs/rls.md.
DB_CONNECTION=pgsql
DB_HOST=127.0.0.1
DB_PORT=5432
DB_DATABASE=clintra
DB_USERNAME=clintra_app
DB_APP_PASSWORD=
DB_PASSWORD="${DB_APP_PASSWORD}"

# Used only to run migrations (php artisan migrate --database=pgsql_owner),
# never by the application at request time.
DB_OWNER_USERNAME=clintra_owner
DB_OWNER_PASSWORD=

# Used ONLY by the RLS isolation test suite (tests/Feature/Rls) to insert and
# clean up fixture data — it bypasses RLS on purpose, so it must never be used
# by application code. Leave blank outside test environments.
DB_FIXTURES_USERNAME=clintra_fixtures
DB_FIXTURES_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"
